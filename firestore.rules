rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user is Super Admin
    function isSuperAdmin() {
      return isSignedIn() && 
        request.auth.token.email != null &&
        (request.auth.token.email.lower() == 'nguyenhuy.thudaumot@gmail.com' || 
         request.auth.token.email.lower() == 'hoanghuutrung1@gmail.com' ||
         request.auth.token.email.lower() == 'vanchien.vov@gmail.com');
    }

    // Check if user is Admin or Editor
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'editor']));
    }

    // Super Admins have full access to everything
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Public content - allow anyone to read
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /music/{songId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }
    
    match /mapPoints/{pointId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin() || isAdmin();
    }

    match /research/{itemId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAdmin();
    }

    match /homepage/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isAdmin();
    }

    match /photovoice/{itemId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin() || isAdmin();
    }

    match /letters/{letterId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin() || isAdmin();
    }

    match /surveys/{surveyId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin() || isAdmin();
    }
    
    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin() || isAdmin();
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isSuperAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /presences/{docId} {
      allow read, write: if true;
    }
  }
}

